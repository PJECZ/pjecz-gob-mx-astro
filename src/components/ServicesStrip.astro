---
import { SERVICES } from '@data/site';
---

<section class="border-y border-gray-200 bg-[#f6f6f4] py-16">
  <div class="mx-auto w-full max-w-7xl px-6">
    <h2 class="mb-6 text-xs font-bold uppercase tracking-[0.15em] text-gray-500">
      Accesos directos
    </h2>
    
    <div class="grid grid-cols-1 border border-gray-300 bg-gray-300 gap-[1px] md:grid-cols-2 lg:grid-cols-4">
      {SERVICES.map((s) => (
        <a 
          href={s.href} 
          class="group flex flex-col bg-[#f6f6f4] p-10 transition-colors duration-200 hover:bg-white"
        >
          <div class="mb-4 h-5 w-5 overflow-hidden">
            <img 
              src="/assets/star.png" 
              alt="" 
              aria-hidden="true" 
              class="h-5 w-5 object-contain opacity-85" 
            />
          </div>
          <h3 class="mb-2 font-serif text-[1.35rem] leading-tight text-[#1a3129]">
            {s.title}
          </h3>
          <p class="text-sm leading-relaxed text-gray-600">
            {s.desc}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>