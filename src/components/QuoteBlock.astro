---
/**
 * QuoteBlock 
 */
---

<section class="relative bg-[#C6CDBE] py-20 px-6 overflow-hidden">
  <img 
    class="absolute inset-0 w-full h-full object-cover opacity-70 pointer-events-none" 
    src="/assets/pattern-stars-sage.png" 
    alt="" 
    aria-hidden="true" 
  />
  <div class="relative max-w-4xl mx-auto text-center">
    <img 
      class="h-10 mx-auto mb-6 opacity-90" 
      src="/assets/star.png" 
      alt="" 
      aria-hidden="true" 
    />
    <blockquote class="font-serif text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-gray-900 leading-snug m-0 tracking-tight">
      “La justicia es la constante y perpetua voluntad de dar a cada quien lo que le corresponde.”
    </blockquote>
    
    <div class="text-[11px] uppercase tracking-[0.22em] text-gray-700 mt-6 font-sans font-medium">
      ULPIANO · DIGESTO, 1, 1, 10
    </div>
  </div>
</section>