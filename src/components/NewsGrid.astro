---
/**
 * NewsGrid — tarjetas de boletines / avisos recientes (home).
 */
import Overline from './Overline.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';
import { NEWS } from '@data/site';

interface Props { limit?: number; }
const { limit } = Astro.props;
const items = limit ? NEWS.slice(0, limit) : NEWS;
---
<section class="news container-wide">
  <div class="news__head">
    <div>
      <Overline>Sala de prensa · Boletines</Overline>
      <h2 class="news__title">Avisos y acuerdos recientes</h2>
    </div>
    <Button variant="link" href="/boletin">Ver todos →</Button>
  </div>
  <div class="news__grid">
    {items.map((n) => (
      <a class="news-card" href={`/boletin/${n.slug}`}>
        <div class="news-card__meta">
          <Badge color={n.color}>{n.cat}</Badge>
          <span class="news-card__date">{n.date}</span>
        </div>
        <h3 class="news-card__title">{n.title}</h3>
        <p class="news-card__excerpt">{n.excerpt}</p>
        <div class="news-card__more">Leer más →</div>
      </a>
    ))}
  </div>
</section>

<style>
  .news { padding-block: var(--space-9); }
  .news__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: var(--space-7);
    border-bottom: 1px solid var(--accent);
    padding-bottom: var(--space-4);
  }
  .news__title { font: 400 var(--fs-40)/1.1 var(--font-display); color: var(--fg); margin-top: 10px; }
  .news__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }

  .news-card {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color .2s ease;
  }
  .news-card:hover { border-color: var(--border-strong); }
  .news-card__meta { display: flex; align-items: center; gap: 10px; }
  .news-card__date { font: 400 var(--fs-12)/1 var(--font-sans); letter-spacing: var(--tracking-wider); color: var(--fg-subtle); }
  .news-card__title { font: 400 var(--fs-24)/1.2 var(--font-display); color: var(--fg); }
  .news-card__excerpt { font: 400 var(--fs-14)/1.55 var(--font-sans); color: var(--fg-muted); }
  .news-card__more {
    margin-top: auto;
    font: 700 var(--fs-12)/1 var(--font-sans);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
  }

  @media (max-width: 860px) { .news__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    .news__grid { grid-template-columns: 1fr; }
    .news__head { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  }
</style>
