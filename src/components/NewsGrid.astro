---
/**
 * NewsGrid — tarjetas de boletines / avisos recientes con Tailwind.
 */
import Overline from './Overline.astro';
import Button from './Button.astro';
import { NEWS } from '@data/site';

interface Props { limit?: number; }
const { limit } = Astro.props;
const items = limit ? NEWS.slice(0, limit) : NEWS;


const getTipoColor = (cat: string) => {
  switch (cat?.toLowerCase()) {
    case 'boletín': return 'bg-blue-900';
    case 'civil': return 'bg-blue-400'; 
    case 'familiar': return 'bg-purple-800';
    case 'aviso': return 'bg-yellow-600'; 1
    case 'penal': return 'bg-red-700';
    default: return 'bg-emerald-800'; // Para 'institucional' u otros
  }
};
---

<section class="max-w-7xl mx-auto px-6 py-16">
  
  <!-- Encabezado de la sección -->
  <div class="flex flex-col md:flex-row items-start md:items-end justify-between border-b-2 border-[#1a3129] pb-4 mb-8 gap-4">
    <div>
      <div class="text-gray-500 uppercase tracking-widest text-xs font-bold">
        <Overline>Sala de prensa · Boletines</Overline>
      </div>
      <h2 class="text-3xl md:text-4xl font-serif text-gray-900 mt-2">Avisos y acuerdos recientes</h2>
    </div>
    <div class="font-bold text-xs uppercase tracking-wider text-[#1a3129] hover:opacity-80 transition-opacity">
      <Button variant="link" href="/boletin">Ver todos →</Button>
    </div>
  </div>

  <!-- Rejilla con tu diseño de tarjetas e identificadores de color -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {items.map((n) => (
      <a 
        href={`/boletin/${n.slug}`}
        class="border border-gray-200 bg-white p-6 flex flex-col hover:shadow-md transition-shadow duration-200 group"
      >
        <div class="flex items-center gap-2 mb-4">
          <!-- Tu badge dinámico adaptado -->
          <span class={`text-white text-[10px] font-bold px-2 py-0.5 uppercase tracking-wider ${getTipoColor(n.cat)}`}>
            {n.cat}
          </span>
          <span class="text-gray-400 text-xs tracking-wider uppercase">{n.date}</span>
        </div>
        
        <h3 class="font-serif text-xl font-bold mb-2 text-gray-900 leading-snug group-hover:text-[#1a3129] transition-colors">
          {n.title}
        </h3>
        
        <p class="text-sm text-gray-600 leading-relaxed mb-6 flex-grow">
          {n.excerpt}
        </p>
        
        <div class="text-xs font-bold uppercase tracking-widest text-gray-900 group-hover:text-[#1a3129] transition-colors mt-auto">
          Leer más →
        </div>
      </a>
    ))}
  </div>
</section>