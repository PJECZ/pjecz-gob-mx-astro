---
import { NAV } from '@data/site';
---

<header class="w-full bg-white border-b border-gray-200">
  
  <div class="w-full px-4 md:px-16 py-6 flex justify-between items-center border-b border-gray-100">
    <a href="/" class="flex items-center">
      <img 
        src="/assets/logo-horizontal.png" 
        alt="Poder Judicial Coahuila de Zaragoza" 
        class="h-20 md:h-[90px] object-contain" 
      />
    </a>

    <div class="flex space-x-2.5">
      <a href="#" class="w-9 h-9 rounded-full bg-[#8c939d] hover:bg-[#2c3e50] flex items-center justify-center text-white text-sm transition-colors">
        <i class="fab fa-twitter"></i>
      </a>
      <a href="#" class="w-9 h-9 rounded-full bg-[#8c939d] hover:bg-[#2c3e50] flex items-center justify-center text-white text-sm transition-colors">
        <i class="fab fa-facebook-f"></i>
      </a>
      <a href="#" class="w-9 h-9 rounded-full bg-[#8c939d] hover:bg-[#2c3e50] flex items-center justify-center text-white text-sm transition-colors">
        <i class="fab fa-vimeo-v"></i>
      </a>
      <a href="#" class="w-9 h-9 rounded-full bg-[#8c939d] hover:bg-[#2c3e50] flex items-center justify-center text-white text-sm transition-colors">
        <i class="fab fa-youtube"></i>
      </a>
    </div>
  </div>

  <div class="w-full bg-[#f8f9fa] flex justify-between items-stretch min-h-[64px] relative">
    
    <nav class="flex space-x-8 items-center pl-4 md:pl-16 py-3">
      {NAV.map((item) => (
        <div class="relative flex items-center group h-full">
          {item.hasDropdown ? (
            <>
              <button class="text-[#2c3e50] font-bold text-[11px] uppercase tracking-wider hover:text-black flex items-center gap-1 cursor-pointer bg-transparent border-none p-0">
                {item.title}
                <span class="text-[8px] text-gray-400 transition-transform group-hover:text-black">▼</span>
              </button>
              
              <div class="absolute top-[100%] left-0 w-52 bg-white border border-gray-200 shadow-xl rounded-b py-2 hidden group-hover:block z-50">
                {item.items?.map((subItem) => (
                  <a 
                    href={subItem.href} 
                    class="block px-4 py-2.5 text-[11px] uppercase tracking-wide text-gray-600 hover:bg-gray-100 hover:text-black font-medium no-underline"
                  >
                    {subItem.label}
                  </a>
                ))}
              </div>
            </>
          ) : (
            <a 
              href={item.href} 
              class="text-[#2c3e50] font-bold text-[11px] uppercase tracking-wider hover:text-black no-underline"
            >
              {item.title}
            </a>
          )}
        </div>
      ))}
    </nav>

    <div class="bg-white border-l border-gray-200 px-6 md:px-12 flex items-center shadow-[-4px_0_12px_rgba(0,0,0,0.02)]">
      <div class="w-64 google-search-wrapper">
        <div class="gcse-search"></div>
      </div>
    </div>

  </div>
</header>

<script is:inline async src="https://cse.google.com/cse.js?cx=33664f175580b4923"></script>

<script>
  document.addEventListener('astro:page-load', () => {
    const globalWindow = window as any;
    
    if (globalWindow.google && globalWindow.google.search) {
      globalWindow.google.search.cse.element.go();
    }
  });
</script>

<style>
 
  .google-search-wrapper {
    background-color: transparent !important; 
    border: none !important;
    box-shadow: none !important;
    height: 38px !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 100% !important;
    max-width: 280px !important; 
    margin: 0 auto !important; 
  }


  .google-search-wrapper :global(.gsc-control-cse) {
    padding: 0 !important;
    background-color: transparent !important;
    border: none !important;
    width: 100% !important;
  }
  
  /* 3. Eliminación total de cualquier borde gris interno de Google */
  .google-search-wrapper :global(.gsc-input-box),
  .google-search-wrapper :global(.gsc-input-box-focus) {
    border: none !important;
    background-color: transparent !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  /* 4. Reseteo completo de las tablas internas de Google */
  .google-search-wrapper :global(table.gsc-search-box),
  .google-search-wrapper :global(table.gsc-search-box td) {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    vertical-align: middle !important;
  }


  .google-search-wrapper :global(input.gsc-input) {
    font-size: 14px !important;
    color: #374151 !important;
    padding-left: 10px !important;
    padding-right: 10px !important;
    margin: 0 !important;
    width: 100% !important;
    height: 100% !important;
    
    
    background-repeat: no-repeat !important;
    background-position: center !important; 
    background-size: contain !important;
  }

 
  .google-search-wrapper :global(.gsc-search-button-v2) {
    background-color: #2c3e50 !important; /* Azul oscuro institucional */
    border: none !important;
    border-radius: 0.375rem !important; 
    margin: 0 0 0 8px !important; /* Separación sutil respecto a la leyenda */
    padding: 0 14px !important;
    height: 34px !important; /* Ligeramente más compacto verticalmente */
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer;
  }

  .google-search-wrapper :global(td.gsc-search-button) {
    vertical-align: middle !important;
    padding: 0 !important;
  }
</style>