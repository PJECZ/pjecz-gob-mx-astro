<style>
  .site-header { border-bottom: 1px solid var(--border); background: var(--bg); display: block; }

  .gov-strip {
    background: var(--pj-black-100);
    color: var(--pj-black-25);
    padding: 8px 0;
    font: 400 var(--fs-12)/1 var(--font-sans);
    letter-spacing: var(--tracking-wide);
  }
  .gov-strip__inner { display: flex; justify-content: space-between; align-items: center; }
  .gov-strip__links { display: flex; gap: var(--space-5); }
  .gov-strip__links a:hover { color: var(--pj-white); }

  .crest-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: 22px;
    justify-content: space-between;
  }
  .crest-lockup img { height: 60px; width: auto; }

  /* Contenedor del Buscador alineado al estilo de la plantilla */
  .search-box-wrapper {
    margin-left: auto;
    min-width: 280px;
    max-width: 320px;
  }

  .primary-nav { border-top: 1px solid var(--border-faint); background: var(--bg-muted); position: relative; }
  .primary-nav__inner { display: flex; flex-wrap: wrap; flex-direction: row; align-items: center; }
  
  .primary-nav__item {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .primary-nav__link {
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 16px 20px;
    font: 700 var(--fs-12)/1 var(--font-sans);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--fg-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color .15s ease, border-color .15s ease;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .primary-nav__link:hover { color: var(--fg); }
  .primary-nav__link.is-active { color: var(--fg); border-bottom-color: var(--accent); }

  .nav-arrow { font-size: 8px; color: var(--fg-faint); transition: transform 0.15s ease; }
  .primary-nav__item:hover .nav-arrow { color: var(--fg); }
  .nav-arrow-right { font-size: 8px; margin-left: auto; color: var(--fg-faint); }

  /* Estructura BEM de los Menús Desplegables mediante CSS Puro */
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 100;
    display: none;
    min-width: 220px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-top: 0;
    padding: 8px 0;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }
  .primary-nav__item:hover .dropdown-menu { display: block; }

  .dropdown-menu__item { position: relative; }

  .dropdown-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    font: 500 var(--fs-12)/1.2 var(--font-sans);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dropdown-menu__link:hover { background: var(--bg-muted); color: var(--fg); }

  /* Submenú de segundo nivel (Sesiones) */
  .dropdown-submenu {
    position: absolute;
    top: 0;
    left: 100%;
    z-index: 101;
    display: none;
    min-width: 240px;
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 8px 0;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  }
  .dropdown-menu__item:hover .dropdown-submenu { display: block; }

  .dropdown-submenu__link {
    display: block;
    padding: 10px 20px;
    font: 500 var(--fs-12)/1.2 var(--font-sans);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dropdown-submenu__link:hover { background: var(--bg-muted); color: var(--fg); }

