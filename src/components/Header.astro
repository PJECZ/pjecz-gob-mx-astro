---
/**
 * Header institucional — lockup del escudo y nav primaria con submenús.
 */
interface SubNavItem { label: string; href?: string; children?: SubNavItem[]; }
interface NavItem { id: string; title: string; href?: string; items?: SubNavItem[]; }
interface Props { current?: string; }
const { current = 'home' } = Astro.props;
const NAV: NavItem[] = [
  { id: 'conocenos', title: 'Conócenos', items: [
    { label: '¿Quiénes somos?', href: '/conocenos/quienes-somos' },
    { label: 'Estructura', href: '/conocenos/estructura' },
    { label: 'Observatorio Judicial', href: '/observatorio-judicial' }
  ]},
  { id: 'consultas', title: 'Consultas', items: [
    { label: 'Acuerdos del Consejo', href: '/category/acuerdos-del-consejo' },
    { label: 'Acuerdos del Pleno', href: '/category/acuerdos-del-pleno' },
    { label: 'Agenda de Audiencias', href: '/consultas/agenda-audiencias' },
    { label: 'Citas', href: '/citas' },
    { label: 'Edictos en Línea', href: '/consultas/edictos' },
    { label: 'Listas de Acuerdo', href: '/consultas/listas-de-acuerdo' },
    { label: 'Poder en línea', href: '/poder-en-linea' },
    { label: 'Tesis y Jurisprudencias', href: '/consultas/tesis-jurisprudencias' },
    { label: 'Tramites y servicios', href: '/tramites-y-servicios' },
    { label: 'Versión Pública de Sentencias', href: '/consultas/sentencias' },
    { label: 'Más...', href: '/consultas/consultas' }
  ]},
  { id: 'prensa', title: 'Sala de Prensa', items: [
    { label: 'Boletines Judiciales', href: '/boletines-judiciales' },
    { label: 'Calendario de Labores', href: '/calendario-de-labores' },
    { label: 'Comunicados', href: '/category/comunicados' },
    { label: 'Entrevistas', href: '/category/entrevistas' },
    { label: 'Noticias', href: '/category/noticias' },
    { label: 'News Letters', href: '/category/news-letter' },
    { label: 'Sesiones', children: [
      { label: 'Pleno del TSJ', href: '/category/pleno-del-tribunal-superior-de-justicia' },
      { label: 'Sala Civil y Mercantil', href: '/category/sala-civil-y-mercantil' },
      { label: 'Sala Familiar', href: '/category/sala-familiar' },
      { label: 'Sala Penal', href: '/sala-de-prensa/category/sala-penal' },
      { label: 'Sala Regional', href: '/category/sala-regional' },
      { label: 'Tribunal Constitucional', href: '/category/tribunal-constitucional' }
    ]}
  ]},
  { id: 'transparencia', title: 'Transparencia', items: [
    { label: 'Transparencia', href: '/transparencia' },
    { label: 'Transparencia Proactiva', href: '/transparencia-proactiva' },
    { label: 'Armonización Contable', href: '/armonizacion-contable' }
  ]},
  { id: 'estudiantes', title: 'Estudiantes', href: '/justicia-para-ti' }
];
---
<header class="site-header">
  <div class="container-wide crest-row">
    <a href="/" class="crest-lockup">
      <img src="/assets/logo-horizontal.png" alt="Poder Judicial del Estado de Coahuila de Zaragoza" />
    </a>
  </div>
  <nav class="primary-nav" aria-label="Navegación principal">
    <div class="container-wide primary-nav__inner">
      {NAV.map((item) => (
        <div class="primary-nav__item">
          {item.items ? (
            <>
              <button 
                class:list={['primary-nav__link', { 'is-active': current === item.id }]}
                aria-expanded="false"
              >
                {item.title} <span class="nav-arrow" aria-hidden="true">▼</span>
              </button>
              <div class="dropdown-menu">
                {item.items.map((sub) => (
                  <div class="dropdown-menu__item">
                    <a href={sub.href || '#'} class="dropdown-menu__link">
                      {sub.label} {sub.children && <span class="nav-arrow-right" aria-hidden="true">▶</span>}
                    </a>
                    
                    {sub.children && (
                      <div class="dropdown-submenu">
                        {sub.children.map((child) => (
                          <a href={child.href} class="dropdown-submenu__link">
                            {child.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </>
          ) : (
            <a
              href={item.href}
              class:list={['primary-nav__link', { 'is-active': current === item.id }]}
              aria-current={current === item.id ? 'page' : undefined}
            >
              {item.title}
            </a>
          )}
        </div>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--border); background: var(--bg); display: block; }
  .crest-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: 22px;
    justify-content: flex-start;
  }
  .crest-lockup img { height: 60px; width: auto; }
  .primary-nav { border-top: 1px solid var(--border-faint); background: var(--bg-muted); position: relative; }
  .primary-nav__inner { display: flex; flex-wrap: wrap; flex-direction: row; align-items: center; position: relative; } 
  .primary-nav__item {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
  }
  .primary-nav__link {
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 16px 20px;
    font: 700 var(--fs-12)/1 var(--font-sans);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--fg-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color .15s ease, border-color .15s ease;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .primary-nav__link:hover { color: var(--fg); }
  .primary-nav__link.is-active { color: var(--fg); border-bottom-color: var(--accent); }
  .nav-arrow { font-size: 8px; color: var(--fg-faint); transition: transform 0.15s ease; }
  .primary-nav__item:hover .nav-arrow { color: var(--fg); }
  .nav-arrow-right { font-size: 8px; margin-left: auto; color: var(--fg-faint); }
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 100;
    display: none;
    min-width: 220px;
    background: #ffffff;
    border: 1px solid var(--border);
    padding: 8px 0;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }
  .primary-nav__item:hover > .dropdown-menu { display: block; }
  .dropdown-menu__item { position: relative; }
  .dropdown-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    font: 500 var(--fs-12)/1.2 var(--font-sans);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }
  .dropdown-menu__link:hover { background: var(--bg-muted); color: var(--fg); }
  .dropdown-submenu {
    position: absolute;
    top: 0;
    left: 100%;
    z-index: 101;
    display: none;
    min-width: 260px;
    background: #ffffff;
    border: 1px solid var(--border);
    padding: 8px 0;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
  .dropdown-menu__item:hover > .dropdown-submenu { display: block; }
  .dropdown-submenu__link {
    display: block;
    padding: 10px 20px;
    font: 500 var(--fs-12)/1.2 var(--font-sans);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: background 0.15s ease, color 0.15s ease;
    white-space: normal;
  }
  .dropdown-submenu__link:hover { background: var(--bg-muted); color: var(--fg); }
  @media (max-width: 760px) {
    .crest-row { flex-wrap: wrap; gap: var(--space-3); }
    .primary-nav__inner { flex-direction: column; align-items: flex-start; }
    .primary-nav__item { width: 100%; }
    .primary-nav__link { padding: 12px 14px; width: 100%; justify-content: space-between; }
    .dropdown-menu { position: static; display: none; width: 100%; border: 0; box-shadow: none; background: var(--bg-muted); padding-left: 10px; }
    .primary-nav__item:hover > .dropdown-menu { display: block; }
    .dropdown-submenu { position: static; display: none; width: 100%; border: 0; box-shadow: none; background: var(--bg); padding-left: 10px; }
    .dropdown-menu__item:hover > .dropdown-submenu { display: block; }
  }
</style>