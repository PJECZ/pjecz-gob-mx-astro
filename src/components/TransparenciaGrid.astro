---
/**
 * TransparenciaGrid — documentos de información pública descargables.
 */
import Overline from './Overline.astro';
import { TRANSPARENCIA } from '@data/site';
---
<section class="trans container">
  <Overline>Transparencia y rendición de cuentas</Overline>
  <h1 class="trans__title">Información pública</h1>
  <div class="trans__grid">
    {TRANSPARENCIA.map((t) => (
      <a class="doc-card" href="#">
        <div class="doc-card__title">{t}</div>
        <div class="doc-card__meta">PDF · 2.1 MB →</div>
      </a>
    ))}
  </div>
</section>
<style>
  .trans { padding-block: var(--space-8); }
  .trans__title { font: 400 var(--fs-48)/1.1 var(--font-display); color: var(--fg); margin: 10px 0 var(--space-7); }
  .trans__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .doc-card {
    border: 1px solid var(--border);
    padding: 22px;
    background: var(--bg);
    transition: border-color .2s ease, background .2s ease;
  }
  .doc-card:hover { border-color: var(--border-strong); background: var(--bg-muted); }
  .doc-card__title { font: 400 var(--fs-18)/1.3 var(--font-display); color: var(--fg); }
  .doc-card__meta {
    font: 700 var(--fs-12)/1 var(--font-sans);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin-top: var(--space-3);
  }
  @media (max-width: 760px) { .trans__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .trans__grid { grid-template-columns: 1fr; } }
</style>
