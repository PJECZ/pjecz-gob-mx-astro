---
import Button from './Button.astro';
---

<section class="relative overflow-hidden bg-[#2c3e50] text-white">
  <img 
    src="/assets/pattern-laurel-dark.png" 
    alt="" 
    aria-hidden="true" 
    class="absolute inset-0 h-full w-full object-cover opacity-35"
  />
  
  <div class="relative mx-auto flex max-w-7xl items-end justify-between gap-12 px-6 py-16 md:py-24">
    
    <div class="flex max-w-2xl flex-col items-start text-left">
      <span class="mb-4 block text-xs font-medium uppercase tracking-[0.22em] text-[#d1d5db]">
        Poder Judicial del Estado de Coahuila de Zaragoza
      </span>
      
      <h1 class="mb-5 text-5xl font-serif leading-[1.05] tracking-tight md:text-6xl">
        Justicia pronta,<br />completa e imparcial.
      </h1>
      
      <p class="mb-8 text-lg text-[#d1d5db] leading-relaxed">
        Portal oficial del Tribunal Superior de Justicia y del Consejo de la Judicatura del Estado. 
        Consulte acuerdos, trámites y servicios con plena transparencia.
      </p>
      
      <div class="flex flex-wrap gap-3">
        <Button variant="light" href="/tramites">Iniciar trámite</Button>
        <Button variant="ghost" href="/boletin">Boletín judicial</Button>
      </div>
    </div>
    
    <div class="hidden shrink-0 items-end md:flex">
      <img 
        src="/assets/logo-vertical-white.png" 
        alt="Logo Institucional" 
        class="w-[280px] object-contain opacity-95" 
      />
    </div>
  </div>
</section>