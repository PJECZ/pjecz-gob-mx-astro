---
// src/components/AccessibilityMenu.astro (Botones para aumentar/disminuir fuente, alternar modo oscuro y alto contraste)
---
<div class="fixed top-1/2 right-0 left-auto transform -translate-y-1/2 flex flex-col shadow-[-2px_2px_10px_rgba(0,0,0,0.3)] z-[9999]">
  <button class="theme-toggle-btn w-[50px] h-[50px] bg-[#262626] border-none cursor-pointer flex items-center justify-center rounded-tl-md transition-all hover:brightness-110" title="Alternar modo oscuro">
    <!-- Icono de luna para modo oscuro, la url avisa a los exploradores que deben cargar el recurso -->
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <button id="text-plus" class="w-[50px] h-[50px] bg-[#3b5998] text-white font-bold text-lg border-none cursor-pointer flex items-center justify-center transition-all hover:brightness-110" title="Aumentar tamaño de texto">
    A+
  </button>
  <button id="text-minus" class="w-[50px] h-[50px] bg-[#1da1f2] text-white font-bold text-lg border-none cursor-pointer flex items-center justify-center transition-all hover:brightness-110" title="Disminuir tamaño de texto">
    A-
  </button>
  <button id="contrast-toggle" class="w-[50px] h-[50px] bg-[#f59e0b] text-white font-bold text-lg border-none cursor-pointer flex items-center justify-center rounded-br-md transition-all hover:brightness-110" title="Activar Alto Contraste">
    <!-- Icono de alto contraste, la url avisa a los exploradores que deben cargar el recurso -->
    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2A10 10 0 0 0 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8v16z"/>
    </svg>
  </button>
</div>
<script>
  function initAccessibility() {
    const savedSize = localStorage.getItem('accessibility-font-size');
    let currentFontSize = savedSize ? parseInt(savedSize) : 100;
    const mainContent = document.querySelector('main');
    if (mainContent) (mainContent as any).style.zoom = (currentFontSize / 100).toString();
    // === CONTROL DE TAMAÑO DE FUENTE ===
    const setupButton = (id: string, isPlus: boolean) => {
      const btn = document.getElementById(id);
      if (btn && btn.parentNode) {
        const newBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(newBtn, btn);
        newBtn.addEventListener('click', () => {
          if ((isPlus && currentFontSize < 130) || (!isPlus && currentFontSize > 90)) {
            currentFontSize += isPlus ? 10 : -10;
            if (mainContent) (mainContent as any).style.zoom = (currentFontSize / 100).toString();
            localStorage.setItem('accessibility-font-size', currentFontSize.toString());
          }
        });
      }
    };
    setupButton('text-plus', true);
    setupButton('text-minus', false);
    // === CONTROL DE MODO OSCURO ===
    document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
      if (btn.parentNode) {
        const newBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(newBtn, btn);
        newBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }
    });
    // === CONTROL DE ALTO CONTRASTE (ACCESIBILIDAD VISUAL) ===
    if (localStorage.getItem('high-contrast') === 'true') {
      document.documentElement.classList.add('high-contrast');
    }
    const contrastBtn = document.getElementById('contrast-toggle');
    if (contrastBtn && contrastBtn.parentNode) {
      const newContrastBtn = contrastBtn.cloneNode(true);
      contrastBtn.parentNode.replaceChild(newContrastBtn, contrastBtn);
      newContrastBtn.addEventListener('click', () => {
        const isHigh = document.documentElement.classList.toggle('high-contrast');
        localStorage.setItem('high-contrast', isHigh ? 'true' : 'false');
      });
    }
  }
  document.addEventListener('astro:page-load', initAccessibility);
</script>
<style is:global>
  /* --- ESTILOS BASE Y TRANSICIONES --- */
  main {
    transition: zoom 0.15s ease-in-out, background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  /* --- 1. MODO CLARO (Por defecto) --- */
  header nav a, header nav span, header ul li a, header a, header span {
    color: #1e293b !important;
    opacity: 1 !important;
  }
  header a[href*="tramite"], header a[href*="iniciar"] {
    background-color: #1e293b !important;
    color: #ffffff !important;
    display: inline-flex !important;
    opacity: 1 !important;
  }
  /* --- 2. MODO OSCURO: NAVBAR --- */
  html.dark header, html.dark header div, html.dark header nav, html.dark header [class*="bg-white"] {
    background-color: #1e293b !important;
  }
  html.dark header nav a, html.dark header nav span, html.dark header ul li a, html.dark header a, html.dark header span, html.dark header nav *, html.dark header ul li * {
    color: #ffffff !important;
    opacity: 1 !important;
  }
  html.dark header nav a:hover, html.dark header ul li a:hover {
    color: #38bdf8 !important;
  }
  html.dark header a[href*="tramite"], html.dark header a[href*="iniciar"], html.dark header a[href*="tramite"] *, html.dark header a[href*="iniciar"] * {
    background-color: #ffffff !important;
    color: #1e293b !important;
    opacity: 1 !important;
    display: inline-flex !important;
  }
  /* --- 3. REDES SOCIALES E ICONOS --- */
  .fa-brands, .fab, .fa-solid, .fas, header a i, html.dark header a i {
    color: #ffffff !important;
  }
  html.dark header a[href*="twitter"], html.dark header a[href*="facebook"], html.dark header a[href*="vimeo"], html.dark header a[href*="youtube"], html.dark header [class*="rounded-full"] {
    background-color: #475569 !important;
  }
  /* --- 4. BUSCADOR DE GOOGLE OSCURECIDO --- */
  html.dark .gsc-control-cse, html.dark .gsc-control-cse * {
    background-color: transparent !important;
    border-color: transparent !important;
  }
  html.dark input.gsc-input, html.dark .gsc-input-box, html.dark td.gsc-input {
    background-color: #334155 !important;
    border: 1px solid #475569 !important;
    color: #ffffff !important;
    border-radius: 4px !important;
  }
  html.dark input.gsc-input::placeholder {
    color: #94a3b8 !important;
  }
  html.dark button.gsc-search-button, html.dark .gsc-search-button-v2 {
    background-color: #475569 !important;
    border-color: #475569 !important;
  }
  html.dark button.gsc-search-button:hover {
    background-color: #38bdf8 !important;
  }

  /* --- 5. TARJETAS DE ACCESOS DIRECTOS --- */
  html.dark .bg-white, html.dark [class*="bg-white"] {
    background-color: #1a252f !important;
    border: 1px solid #334155 !important;
  }
  html.dark h3, html.dark p, html.dark .text-gray-800, html.dark .text-gray-600 {
    color: #f3f4f6 !important;
  }
  html.dark header .absolute, html.dark header div[class*="absolute"] {
    background-color: #243342 !important;
  }
  /* --- 6. SECCIÓN DE AVISOS Y ENLACES "LEER MÁS" --- */
  html.dark h2, html.dark [class*="text-"] h2, html.dark section h2 {
    color: #ffffff !important;
  }
  html.dark section span, html.dark .text-gray-500, html.dark .text-slate-500 {
    color: #94a3b8 !important;
  }
  html.dark .grid a, html.dark section a, html.dark [class*="bg-"] a, html.dark a[class*="text-"], html.dark .grid a span, html.dark section a span {
    color: #ffffff !important;
    opacity: 1 !important;
  }
  html.dark section a:hover, html.dark .grid a:hover {
    color: #38bdf8 !important;
    text-decoration: underline !important;
  }
  /* --- 8. FILTRO DE ALTO CONTRASTE PARA DEBILIDAD VISUAL --- */
  html.high-contrast {
    filter: contrast(200%) brightness(105%) !important;
  }
  html.high-contrast img, 
  html.high-contrast video,
  html.high-contrast iframe {
    filter: contrast(50%) !important;
  }
</style>