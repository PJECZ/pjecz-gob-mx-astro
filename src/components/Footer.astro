---
import { FOOTER_COLS } from '@data/site';
---

<footer class="mt-16 border-t border-gray-800 bg-[#1a1a1a] px-6 pt-12 pb-8 text-gray-400">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-5">
      
      <div class="lg:col-span-1">
        <img 
          src="/assets/logo-vertical-white.png" 
          alt="Poder Judicial del Estado de Coahuila de Zaragoza" 
          class="h-32 w-auto object-contain" 
        />
        <p class="mt-4 max-w-[280px] text-sm leading-relaxed text-gray-500">
          Palacio de Justicia, Saltillo, Coahuila de Zaragoza. México.
        </p>
      </div>

      {FOOTER_COLS.map((col) => (
        <div class="flex flex-col">
          <h4 class="mb-5 text-xs font-bold uppercase tracking-widest text-white">
            {col.title}
          </h4>
          <ul class="flex flex-col gap-2.5">
            {col.items.map((item) => (
              <li>
                <a href="#" class="text-sm transition-colors hover:text-white">
                  {item}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap justify-between gap-4 border-t border-white/10 pt-6 text-xs tracking-wide text-gray-500">
      <span>&copy; 2026 PODER JUDICIAL DEL ESTADO DE COAHUILA DE ZARAGOZA</span>
      <div class="flex flex-wrap gap-4 uppercase">
        <span>Todos los derechos reservados</span>
        <a href="#" class="hover:text-white">Aviso de Privacidad</a>
        <a href="#" class="hover:text-white">Accesibilidad</a>
      </div>
    </div>
  </div>
</footer>