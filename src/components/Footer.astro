---
//Footer.astro-PJECZ
interface FooterColumn {
  title: string;
  items: string[];
}
const FOOTER_COLS: FooterColumn[] = [
  { title: 'Institución', items: ['Historia', 'Magistrados', 'Organigrama', 'Normativa', 'Transparencia'] },
  { title: 'Servicios', items: ['Consulta de expedientes', 'Agenda de audiencias', 'Trámites en línea', 'Peritos', 'Mediadores'] },
  { title: 'Publicaciones', items: ['Boletín judicial', 'Gaceta', 'Acuerdos plenarios', 'Jurisprudencia', 'Informe anual'] },
  { title: 'Contacto', items: ['Directorio', 'Contraloría', 'Quejas y sugerencias', 'Aviso de privacidad'] }
];
---
<footer class="mt-16 border-t border-gray-800 bg-[#1a1a1a] px-6 pt-12 pb-8 text-gray-400">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-1">
        <img src="/assets/logo-vertical-white.png" alt="Poder Judicial del Estado de Coahuila de Zaragoza" class="h-32 w-auto object-contain" />
        <p class="mt-4 max-w-[280px] text-sm leading-relaxed text-gray-500">
          Palacio de Justicia, Saltillo, Coahuila de Zaragoza. México.
        </p>
      </div>
      {FOOTER_COLS.map((col) => (
        <div class="flex flex-col">
          <h4 class="mb-5 text-xs font-bold uppercase tracking-widest text-white">
            {col.title}
          </h4>
          <ul class="flex flex-col gap-2.5">
            {col.items.map((item) => (
              <li>
                <a href="#" class="text-sm transition-colors hover:text-white">
                  {item}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 flex flex-wrap justify-between gap-4 border-t border-white/10 pt-6 text-xs tracking-wide text-gray-500">
      <span>&copy; 2026 PODER JUDICIAL DEL ESTADO DE COAHUILA DE ZARAGOZA</span>
      <div class="flex flex-wrap gap-4 uppercase">
        <span>Todos los derechos reservados</span>
        <a href="#" class="hover:text-white">Aviso de Privacidad</a>
        <a href="#" class="hover:text-white">Accesibilidad</a>
      </div>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    background: var(--pj-black-100);
    color: var(--pj-black-25);
    margin-top: var(--space-9);
    padding: var(--space-8) 0 var(--space-6);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: var(--space-7);
  }
  .footer-brand img { height: 140px; width: auto; }
  .footer-brand p {
    font: 400 var(--fs-13)/1.55 var(--font-sans);
    color: var(--pj-black-50);
    margin-top: var(--space-4);
    max-width: 280px;
  }
  .footer-col__title {
    font: 700 var(--fs-12)/1 var(--font-sans);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--pj-white);
    margin-bottom: var(--space-5);
  }
  .footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .footer-col a {
    font: 400 var(--fs-13) var(--font-sans);
    color: var(--pj-black-25);
  }
  .footer-col a:hover { color: var(--pj-white); }

  .footer-legal {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255,255,255,.12);
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    font: 400 var(--fs-12)/1 var(--font-sans);
    letter-spacing: var(--tracking-wide);
    color: var(--pj-black-50);
  }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>