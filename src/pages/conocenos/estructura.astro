---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Estructura | Poder Judicial del Estado de Coahuila de Zaragoza">
  <main class="max-w-7xl mx-auto px-6 py-12">
    <header class="mb-10">
      <p class="text-xs text-gray-500 uppercase tracking-widest mb-2">Conócenos / Estructura</p>
      <h1 class="text-4xl font-serif text-slate-900">Estructura</h1>
    </header>

    <nav class="text-slate-800" aria-label="Estructura organizacional">
      <ul class="space-y-8">
        <li><a href="/conocenos/tribunal-disciplina" class="text-2xl font-bold text-slate-900 hover:text-sky-700 transition-colors">Tribunal de Disciplina</a></li>
        <li><a href="/conocenos/comision-transicion" class="text-2xl font-bold text-slate-900 hover:text-sky-700 transition-colors">Comisión de Transición</a></li>
        <li><a href="/conocenos/organo-administracion" class="text-2xl font-bold text-slate-900 hover:text-sky-700 transition-colors">Órgano de Administración Judicial</a></li>

        <li>
          <a href="/conocenos/tribunal-superior" class="block text-2xl font-bold text-slate-900 hover:text-sky-700 transition-colors mb-4">Tribunal Superior de Justicia</a>
          
          <div class="ml-6 border-l-2 border-gray-200 pl-6 space-y-8">
            <section>
              <h3 class="font-bold text-lg text-slate-900 mb-2">Presidencia</h3>
              <ul class="space-y-1 text-slate-600">
                <li><a href="/presidencia/presidencia" class="hover:underline hover:text-sky-700">Presidencia</a></li>
                <li><a href="/presidencia/secretaria-tecnica" class="hover:underline hover:text-sky-700">Secretaría Técnica y de Planeación</a></li>
                <li><a href="/presidencia/auditoria-interna" class="hover:underline hover:text-sky-700">Auditoría Interna</a></li>
                <li><a href="/presidencia/archivo-judicial" class="hover:underline hover:text-sky-700">Archivo Judicial General</a></li>
              </ul>
            </section>

            <section>
              <h3 class="font-bold text-lg text-slate-900 mb-3">Órganos Jurisdiccionales</h3>
              <ul class="space-y-4 text-slate-600">
                <li>
                  <a href="/jurisdiccionales/central-actuarios" class="block font-semibold text-slate-800 hover:text-sky-700 transition-colors">Central de Actuarios</a>
                  <ul class="ml-4 mt-1 text-sm space-y-1">
                    <li><a href="/actuarios/saltillo" class="hover:underline hover:text-sky-700">Central de Actuarios de Saltillo</a></li>
                    <li><a href="/actuarios/torreon" class="hover:underline hover:text-sky-700">Central de Actuarios de Torreón</a></li>
                  </ul>
                </li>
                
                <li>
                  <a href="/jurisdiccionales/juzgados-distrito" class="block font-semibold text-slate-800 hover:text-sky-700 transition-colors">Juzgados por Distrito</a>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4 ml-4 text-sm mt-2">
                    {['Acuña', 'Monclova', 'Parras de la Fuente', 'Río Grande', 'Región Carbonífera', 'San Pedro', 'Torreón', 'Saltillo'].map((lugar) => (
                      <a href={`/juzgados/${lugar.toLowerCase().replace(' ', '-')}`} class="hover:underline hover:text-sky-700">• {lugar}</a>
                    ))}
                  </div>
                </li>
              </ul>
            </section>
          </div>
        </li>

        <li class="pt-8 border-t border-gray-200">
          <a href="/conocenos/no-jurisdiccionales" class="text-2xl font-bold text-slate-900 hover:text-sky-700 mb-4 block transition-colors">Órganos No Jurisdiccionales</a>
          <ul class="ml-6 space-y-2 text-slate-700 list-disc">
            <li><a href="/no-jurisdiccionales/centro-evaluacion-psicosocial" class="hover:underline hover:text-sky-700">Centro de Evaluación Psicosocial</a></li>
            <li><a href="/no-jurisdiccionales/medios-alternos" class="hover:underline hover:text-sky-700">Centro de Medios Alternos de Solución de Controversias</a></li>
            <li><a href="/no-jurisdiccionales/instituto-especializacion" class="hover:underline hover:text-sky-700">Instituto de Especialización Judicial</a></li>
          </ul>
        </li>
      </ul>
    </nav>
  </main>
</BaseLayout>