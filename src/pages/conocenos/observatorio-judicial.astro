---
import BaseLayout from '../../layouts/BaseLayout.astro';

import banner from '../../assets/img/observatorio-judicial/hd-observatorio-jud.jpg';
import iconMision from '../../assets/img/observatorio-judicial/mision.png';
import iconCreacion from '../../assets/img/observatorio-judicial/creacion.png';
import iconIntegracion from '../../assets/img/observatorio-judicial/integracion.png';
import iconQueHacemos from '../../assets/img/observatorio-judicial/que-hacemos.png';
import iconEncuestas from '../../assets/img/observatorio-judicial/encuestas.png';
import iconCapitulos from '../../assets/img/observatorio-judicial/capitulos.png';
import iconAliados from '../../assets/img/observatorio-judicial/aliados.png';
import iconPreguntas from '../../assets/img/observatorio-judicial/preguntas-frecuentes.png';

const navItems = [
  { title: "Misión", slug: "mision", icon: iconMision },
  { title: "¿Cómo fue creado?", slug: "creacion", icon: iconCreacion },
  { title: "Integración", slug: "integracion", icon: iconIntegracion },
  { title: "¿Qué hacemos?", slug: "que-hacemos", icon: iconQueHacemos },
  { title: "Encuestas", slug: "encuestas", icon: iconEncuestas },
  { title: "Capítulos Regionales", slug: "capitulos", icon: iconCapitulos },
  { title: "Aliados", slug: "aliados", icon: iconAliados },
  { title: "Preguntas frecuentes", slug: "preguntas-frecuentes", icon: iconPreguntas },
];
---

<BaseLayout title="Observatorio Judicial | Poder Judicial del Estado de Coahuila de Zaragoza">
  <main class="max-w-7xl mx-auto px-6 py-12">
    <header class="mb-12">
      <div class="mb-8">
        <img 
          src={banner.src} 
          alt="Observatorio Judicial Coahuila" 
          class="w-full h-auto max-h-80 object-cover rounded-lg shadow-sm" 
        />
      </div>
      <h1 class="text-4xl font-serif text-slate-900 mb-6">Observatorio judicial ciudadano</h1>
      <p class="text-lg text-slate-700 max-w-4xl leading-relaxed">
        Es un órgano colegiado ciudadanizado de consulta y apoyo del Poder Judicial del Estado de Coahuila de Zaragoza, 
        con autonomía de operación, adscrito a la Presidencia del Tribunal Superior de Justicia del Estado.
      </p>
    </header>

    <nav class="grid grid-cols-2 md:grid-cols-4 gap-12 mb-16" aria-label="Secciones del Observatorio">
      {navItems.map((item) => (
        <a 
          href={`/observatorio/${item.slug}`} 
          class="flex flex-col items-center text-center group transition-transform hover:scale-105"
        >
          <div class="w-24 h-24 mb-4 flex items-center justify-center overflow-hidden">
            <img 
              src={item.icon.src} 
              alt={item.title} 
              class="w-full h-full object-contain" 
            />
          </div>
          <span class="font-bold text-slate-800 text-lg leading-tight group-hover:text-sky-700 transition-colors">
            {item.title}
          </span>
        </a>
      ))}
    </nav>
  </main>
</BaseLayout>