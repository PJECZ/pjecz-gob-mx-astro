---
import BaseLayout from '../../layouts/BaseLayout.astro';
import datosJuzgados from '../../data/juzgados.json';
---

<BaseLayout title="Listas de acuerdo">
  <main class="max-w-4xl mx-auto px-6 py-12">
    
    <header class="mb-8">
      <h1 class="text-3xl font-serif text-slate-900 mb-4">Listas de Acuerdos</h1>
      <p class="text-slate-700 leading-relaxed mb-6">
        Actuaciones que realiza diariamente el Poder Judicial del Estado de Coahuila de Zaragoza y que por ley de acuerdo al Código Procesal Civil deben de ser publicadas; en donde se incluyen autos, acuerdos, sentencias, exhortos y audiencias.
      </p>

      <h3 class="font-bold text-slate-900 mb-1">Instrucciones</h3>
      <p class="text-sm text-slate-600 leading-relaxed">
        Elija el Distrito/Grupo, después el Juzgado o Autoridad. Aparecerá la tabla con las listas de acuerdos en orden cronológico. Puede filtrar por fechas. Para cambiar de distrito o juzgado de clic en Cambiar.
      </p>
    </header>

    <div id="filtro-app" data-juzgados={JSON.stringify(datosJuzgados)}>
      
      <section id="form-section" class="bg-[#f9f7f2] border border-gray-200 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-600 mb-2">Elija el Distrito/Grupo</label>
            <select id="distrito-select" class="w-full p-3 border border-gray-300 bg-white text-sm">
              <option value="">Seleccione el distrito...</option>
              {Object.keys(datosJuzgados).map(key => (
                <option value={key}>{key.replace(/[-_]/g, ' ').toUpperCase()}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-bold uppercase tracking-widest text-slate-600 mb-2">Elija el Juzgado/Autoridad</label>
            <select id="juzgado-select" class="w-full p-3 border border-gray-300 bg-white text-sm" disabled>
              <option value="">Seleccione el distrito primero...</option>
            </select>
          </div>
        </div>
        <button id="filtrar-btn" class="px-6 py-3 bg-[#005a8d] text-white text-xs font-bold uppercase tracking-widest hover:bg-black transition">
          Filtrar
        </button>
      </section>

      <section id="tabla-section" class="hidden bg-white border border-gray-200 p-8">
        <div class="mb-6 flex justify-between items-start">
          <div>
            <h2 id="resultado-titulo" class="font-bold text-lg text-slate-900"></h2>
          </div>
          <button id="cambiar-btn" class="px-4 py-2 bg-amber-500 text-white text-[10px] font-bold uppercase tracking-widest hover:bg-amber-600">
            Cambiar
          </button>
        </div>
        
        <div id="md-content" class="overflow-x-auto">
          </div>
      </section>

    </div>
  </main>
</BaseLayout>

<script>
  interface Acuerdo { exp: string; act: string; not: string; }
  
  const datosAcuerdos: Record<string, Acuerdo[]> = {
    "J. CIVIL Y FAMILIAR ACUÑA": [
      { exp: "00062/1981", act: "ADOPCION - RENE ALFARO SANCHEZ", not: "L" },
      { exp: "00086/2025", act: "CIVIL ORDINARIO - PATRICIA BORREGO", not: "L" }
    ]
  };

  const app = document.getElementById('filtro-app');
  if (app) {
    const data = JSON.parse(app.dataset.juzgados || '{}');
    const distSelect = app.querySelector('#distrito-select') as HTMLSelectElement;
    const juzgSelect = app.querySelector('#juzgado-select') as HTMLSelectElement;
    const filtrarBtn = app.querySelector('#filtrar-btn');
    const cambiarBtn = app.querySelector('#cambiar-btn');
    const formSection = app.querySelector('#form-section') as HTMLElement;
    const tablaSection = app.querySelector('#tabla-section') as HTMLElement;
    const mdContent = document.getElementById('md-content');
    const titulo = app.querySelector('#resultado-titulo');

    distSelect.addEventListener('change', () => {
      juzgSelect.innerHTML = '<option value="">Seleccione el juzgado...</option>';
      const dist = distSelect.value;
      if (dist && data[dist]) {
        juzgSelect.disabled = false;
        data[dist].forEach((j: string) => {
          const opt = document.createElement('option'); opt.value = j; opt.textContent = j;
          juzgSelect.appendChild(opt);
        });
      }
    });

    filtrarBtn?.addEventListener('click', () => {
      if (juzgSelect.value) {
        titulo!.textContent = juzgSelect.value;
        formSection.classList.add('hidden');
        tablaSection.classList.remove('hidden');
        
        const acuerdos: Acuerdo[] = datosAcuerdos[juzgSelect.value] || [];
        mdContent!.innerHTML = `
          <table class="w-full text-left border-collapse">
            <thead><tr class="border-b-2 border-slate-300"><th class="p-2 text-[10px] uppercase font-bold">Expediente</th><th class="p-2 text-[10px] uppercase font-bold">Actuación</th><th class="p-2 text-[10px] uppercase font-bold">Notif.</th></tr></thead>
            <tbody>${acuerdos.map((i: Acuerdo) => `<tr class="border-b border-slate-100"><td class="p-2 font-mono text-sm">${i.exp}</td><td class="p-2 text-sm">${i.act}</td><td class="p-2 text-sm font-bold text-center">${i.not}</td></tr>`).join('')}</tbody>
          </table>
        `;
      }
    });

    cambiarBtn?.addEventListener('click', () => {
      formSection.classList.remove('hidden');
      tablaSection.classList.add('hidden');
    });
  }
</script>