---
// Ruta Dinámica - Detalle de Avisos y Boletines - Poder Judicial del Estado de Coahuila
import BaseLayout from '@layouts/BaseLayout.astro';
import Badge from '@components/Badge.astro';
import RuleLine from '@components/RuleLine.astro';
interface NewsItem {
  slug: string;
  cat: string;
  color: string;
  date: string;
  title: string;
  excerpt: string;
}
export function getStaticPaths() {
  const DATA: NewsItem[] = [
    { slug: 'acuerdos-plenarios-abril', cat: 'BOLETÍN', color: '#39444B', date: '24 ABR 2026', title: 'Acuerdos plenarios del Tribunal Superior de Justicia', excerpt: 'Publicación de resoluciones correspondientes al mes en curso, con efectos a partir del lunes 28 de abril.' },
    { slug: 'nueva-sede-civil-torreon', cat: 'CIVIL', color: '#323B6B', date: '23 ABR 2026', title: 'Nueva sede del Juzgado Cuarto de lo Civil en Torreón', excerpt: 'La nueva sede abrirá al público el próximo 5 de mayo con horario regular de ventanilla.' },
    { slug: 'protocolo-atencion-familiar', cat: 'FAMILIAR', color: '#5F2D71', date: '22 ABR 2026', title: 'Protocolo de atención a usuarios en materia familiar', excerpt: 'Se actualizan los lineamientos para el acompañamiento a personas en situación de vulnerabilidad.' },
    { slug: 'suspension-labores-1-mayo', cat: 'AVISO', color: '#486238', date: '21 ABR 2026', title: 'Suspensión de labores el 1 de mayo de 2026', excerpt: 'Por conmemoración del Día del Trabajo, no habrá actividad jurisdiccional ni administrativa.' },
    { slug: 'capacitacion-sistema-acusatorio', cat: 'PENAL', color: '#9E3182', date: '20 ABR 2026', title: 'Capacitación continua en el sistema acusatorio', excerpt: 'Inscripciones abiertas para magistrados y personal jurisdiccional del primer distrito judicial.' },
    { slug: 'informe-anual-labores-2025', cat: 'INSTITUCIONAL', color: '#4B5760', date: '18 ABR 2026', title: 'Informe anual de labores 2025', excerpt: 'Disponible para consulta pública en la sección de Transparencia.' }
  ];
  return DATA.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}
interface Props {
  item: NewsItem;
}
const { item } = Astro.props;
---
<BaseLayout current="boletin" title={`${item.title} — Boletín judicial`}>
  <article class="article container-narrow">
    <a class="article__back" href="/boletin">← Regresar al boletín</a>
    <div class="article__meta">
      <Badge color={item.color}>{item.cat}</Badge>
      <span class="article__date">{item.date} · SALTILLO, COAH.</span>
    </div>
    <h1 class="article__title">{item.title}</h1>
    <p class="article__lede">{item.excerpt}</p>
    <RuleLine />
    <div class="article__body">
      <p>Por acuerdo del Pleno del Tribunal Superior de Justicia, en su sesión ordinaria del día {item.date.toLowerCase()}, se hace del conocimiento público la publicación de las resoluciones emitidas durante el mes.</p>
      <p>Los interesados podrán consultar el texto íntegro en la sección de <em>Transparencia y rendición de cuentas</em> del presente portal, o bien, en la ventanilla de archivo judicial ubicada en el Palacio de Justicia de Saltillo, en horario de 9:00 a 14:00 horas.</p>
      <p>Lo anterior, con fundamento en los artículos 144 y 145 de la Ley Orgánica del Poder Judicial del Estado.</p>
      <p class="article__sign">
        Atentamente,<br />
        Secretaría General de Acuerdos<br />
        Saltillo, Coahuila de Zaragoza
      </p>
    </div>
  </article>
</BaseLayout>
<style>
  .article { padding-block: var(--space-8) var(--space-9); }
  .article__back {
    display: inline-block;
    font: 700 var(--fs-12)/1 var(--font-sans);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: var(--space-6);
  }
  .article__back:hover { color: var(--fg); }
  .article__meta { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); }
  .article__date { font: 400 var(--fs-12)/1 var(--font-sans); letter-spacing: var(--tracking-wider); color: var(--fg-subtle); }
  .article__title { font: 400 var(--fs-48)/1.1 var(--font-display); letter-spacing: -.005em; color: var(--fg); margin-bottom: var(--space-5); }
  .article__lede { font: 400 var(--fs-24)/1.45 var(--font-display); color: var(--fg); }
  .article__body { font: 400 var(--fs-18)/1.7 var(--font-sans); color: var(--fg); }
  .article__body p { margin-bottom: 1.1em; }
  .article__sign { margin-top: var(--space-6); text-align: right; font-style: italic; color: var(--fg-muted); }
</style>