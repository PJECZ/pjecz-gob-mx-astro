---
// src/pages/acuerdos/[page].astro


import acuerdosData from '../../data/acuerdos.json'; 
import Button from '../../components/Button.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';


import type { Page } from 'astro';

interface Props {
  page: Page<any>;
}


export async function getStaticPaths({ paginate }: { paginate: any }) {
  const todosLosAcuerdos = acuerdosData.data;

  return paginate(todosLosAcuerdos, { pageSize: 12 });
}


const { page } = Astro.props;


const formatearFecha = (fechaStr: string) => {
  const opciones: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
  return new Date(fechaStr).toLocaleDateString('es-MX', opciones);
};
---

<BaseLayout title={`Acuerdos del Consejo — Página ${page.currentPage}`}>
  <main class="container-wide acuerdos-section">
    <header class="acuerdos-header">
      <p class="overline">Boletines Informativos</p>
      <h1 class="h1">Acuerdos recientes</h1>
      <p class="body-text">Consulte las minutas, acuerdos institucionales y resoluciones emitidas por el Consejo de la Judicatura.</p>
    </header>

    <div class="acuerdos-grid">
      {page.data.map((acuerdo: any) => (
        <article class="acuerdo-card">
          <div class="acuerdo-card__meta">
            <span class="badge">{acuerdo.category}</span>
            <time datetime={acuerdo.date} class="acuerdo-card__date">
              {formatearFecha(acuerdo.date)}
            </time>
          </div>
          
          <h2 class="acuerdo-card__title">{acuerdo.title}</h2>
          
          <p class="acuerdo-card__summary">
            {acuerdo.summary || "Sin extracto disponible. Dé clic en el enlace para consultar los detalles completos del acuerdo."}
          </p>
          
          <div class="acuerdo-card__action">
            <a href={acuerdo.url} target="_blank" rel="noopener noreferrer" class="btn-link">
              Leer más —>
            </a>
          </div>
        </article>
      ))}
    </div>

    <nav class="pagination-bar" aria-label="Navegación de páginas de acuerdos">
      {page.url.prev ? (
        <a href={page.url.prev} class="pagination-btn">← Anterior</a>
      ) : (
        <span class="pagination-btn pagination-btn--disabled">← Anterior</span>
      )}
      
      <span class="pagination-info">
        Página <strong>{page.currentPage}</strong> de {page.lastPage}
      </span>
      
      {page.url.next ? (
        <a href={page.url.next} class="pagination-btn">Siguiente →</a>
      ) : (
        <span class="pagination-btn pagination-btn--disabled">Siguiente →</span>
      )}
    </nav>
  </main>
</BaseLayout>

<style>
  .acuerdos-section {
    padding-block: var(--space-8) var(--space-9);
  }
  
  .acuerdos-header {
    margin-bottom: var(--space-7);
    max-width: 600px;
  }

  .body-text {
    font-family: var(--font-sans);
    color: var(--fg-subtle);
    margin-top: var(--space-3);
  }

  .acuerdos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .acuerdo-card {
    background: var(--bg-muted, #f8f9fa);
    border: 1px solid rgba(0,0,0,0.08);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 260px;
  }

  .acuerdo-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .acuerdo-card__date {
    font: 700 var(--fs-12)/1 var(--font-sans);
    text-transform: uppercase;
    color: var(--fg-subtle);
    letter-spacing: var(--tracking-wide);
  }

  .acuerdo-card__title {
    font: 400 var(--fs-20)/1.3 var(--font-display);
    color: var(--pj-ink);
    margin-bottom: var(--space-3);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .acuerdo-card__summary {
    font: 400 var(--fs-14)/1.5 var(--font-sans);
    color: var(--fg-subtle);
    margin-bottom: var(--space-5);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .acuerdo-card__action {
    margin-top: auto;
  }

  .btn-link {
    font: 700 var(--fs-12)/1 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--pj-blue, #2c3e50);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    display: inline-block;
  }

  .pagination-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-5);
    border-top: 1px solid rgba(0,0,0,0.1);
    padding-top: var(--space-6);
  }

  .pagination-btn {
    font: 700 var(--fs-13)/1 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding: 10px 20px;
    border: 1px solid var(--fg);
    color: var(--fg);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .pagination-btn:not(.pagination-btn--disabled):hover {
    background-color: rgba(0,0,0,0.05);
  }

  .pagination-btn--disabled {
    border-color: rgba(0,0,0,0.15);
    color: rgba(0,0,0,0.3);
    cursor: not-allowed;
  }

  .pagination-info {
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    color: var(--fg-subtle);
  }
</style>