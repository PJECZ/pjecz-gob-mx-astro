---
/**
 * BaseLayout — documento HTML con Header + slot + Footer.
 * Importa los estilos globales (tokens + base) una sola vez.
 */
import '@styles/tokens.css';
import '@styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import AccessibilityMenu from '@components/AccessibilityMenu.astro';
// 1. Importamos el componente de transiciones de Astro (ClientRouter) para habilitar la navigation sin recarga de página.
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}

const {
  title = 'Poder Judicial del Estado de Coahuila de Zaragoza',
  description = 'Portal oficial del Tribunal Superior de Justicia y del Consejo de la Judicatura del Estado de Coahuila de Zaragoza.',
  current = 'home',
} = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/assets/star.png" />
  <title>{title}</title>

  <ClientRouter />
  <script src="https://unpkg.com/@tailwindcss/browser@4" data-astro-rerun="false"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <script is:inline>
    const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    if (savedTheme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>

  <style is:global>
    /* Forzar colores de iconos */
    .fa-brands, .fab, .fa-solid, .fas {
      color: #ffffff !important;
    }

    /* Transición suave para cambios de tamaño de letra y colores */
    html, body {
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    /* Solución de respaldo: Si el CDN de Tailwind v4 falla, el CSS nativo responde inmediatamente */
    html.dark body, html.dark main, html.dark .bg-white {
      background-color: #1a252f !important;
      color: #f3f4f6 !important;
    }

    /* Asegurar que los textos cambien de color correctamente en modo oscuro */
    html.dark p, html.dark h1, html.dark h2, html.dark h3, html.dark span, html.dark a {
      color: #f3f4f6 !important;
    }

    /* Ajustar menús desplegables del header en modo oscuro para evitar textos invisibles */
    html.dark .group-hover\:block, html.dark .absolute {
      background-color: #243342 !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-white text-gray-800">

  <Header current={current} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
  <AccessibilityMenu />

</body>
</html>