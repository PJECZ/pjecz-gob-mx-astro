---
import DefaultLayout from "./BaseLayout.astro";
---

<DefaultLayout>
    <div class="md-container">
        <article class="prose dark:prose-invert prose-custom">
            <slot />
        </article>
    </div>
</DefaultLayout>

<style>
        /* Estilos necesarios para centrar el contenido  */
    /* Contendedor principal para centrar  */
    .md-container {
        width: 100%;
        max-width: 1000px; /* Grosor del margen*/
        margin-left: auto;
        margin-right: auto;
        padding-left: 2rem;  /* Margen izquierdo  */
        padding-right: 2rem; /* Margen derecho */
        padding-top: 2.5rem;
        padding-bottom: 4rem;
        box-sizing: border-box;
    }
    .prose-custom {
        max-width: 100% !important;
    }
</style>